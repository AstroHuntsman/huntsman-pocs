## SYSTEM Variables
export PANUSER="huntsman" # All hosts - User name
export PANDIR="/var/huntsman" # Control & Camera - working dir
export PANLOG="${PANDIR}/logs" # Control - logs
export HUNTSMAN_POCS="${PANDIR}/huntsman-pocs" # Control - pocs repo
export HUNTSMAN_DOME="${PANDIR}/huntsman-dome" # Control - dome repo
export HUNTSMAN_DRP="${PANDIR}/huntsman-drp" # Control - drp repo
export HUNTSMAN_CONFIG="${PANDIR}/huntsman-config" # Control - config repo
export IMAGES_SHARE_DIR="/var/huntsman/images" # Control - location of the NFS share on the control machine

## SSH ACCESS - The following hosts should be configured in ~/.ssh/config
export HUNTSMAN_REMOTE_HOST="huntsman_remote"
export HUNTSMAN_CONTROL_HOST="huntsman_control"
export HUNTSMAN_CONTROL_IP="192.168.x.x"
export HUNTSMAN_CAMERAS='[{"hostname": "huntsman_cam1", "num": 1, "use": "false"},{"hostname": "huntsman_cam2", "num": 2, "use": "false"},{"hostname": "huntsman_cam3", "num": 3, "use": "true"},{"hostname": "huntsman_cam4", "num": 4, "use": "true"},{"hostname": "huntsman_cam5", "num": 5, "use": "false"},{"hostname": "huntsman_cam6", "num": 6, "use": "false"},{"hostname": "huntsman_cam7", "num": 7, "use": "false"},{"hostname": "huntsman_cam8", "num": 8, "use": "false"},{"hostname": "huntsman_cam9", "num": 9, "use": "false"},{"hostname": "huntsman_cam10", "num": 10, "use": "false"}]'

## CONFIG
export PANOPTES_CONFIG_HOST="0.0.0.0" # The host running the config container
export PANOPTES_CONFIG_PORT=6563 # The config port

## NATS Configuration
export NATS_SERVER="nats://localhost:4222" # Control - Nats server host
export NATS_STATS_FILE="/tmp/stream_stats.json" # Control - stream stats file
export NATS_NUM_STREAMS=10 # Control - number of Nats streams
export NATS_NUM_CONSUMERS=10 # Remote - number of Nats consumers
export NATS_NUM_WRITER_THREADS=4 # Remote - number of threads for writing files
export MEMORY_STATUS_FILE="${PANDIR}/images/memory_status.json" # Control & Camera (mounted) - memory status information
export MEMORY_THRESHOLD=31 # Control - Prevent publishing to memory streams if memory usage above this percentage use

## Docker
export DOCKER_USER="huntsmanarray" # The docker user - used as a url indicator for docker hub pulling (when running) and pushing (when building)
export DOCKER_TAG="develop" # The docker image tag for huntsman images. Will be used for building and pulling.
export DOCKER_PAT="my_docker_person_access_token" # Your docker personal access token. Necessary for pushing images to docker hub.
