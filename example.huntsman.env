export PANUSER="huntsman"
export PANDIR="/var/huntsman"
export PANLOG="${PANDIR}/logs"
export POCS="${PANDIR}/POCS"
export PAWS="${PANDIR}/PAWS"
export HUNTSMAN_POCS="${PANDIR}/huntsman-pocs"
export HUNTSMAN_DOME="${PANDIR}/huntsman-dome"
export HUNTSMAN_DRP="${PANDIR}/huntsman-drp"
export HUNTSMAN_LOG_DIR="${PANDIR}/logs"
export HUNTSMAN_ENV_MONITOR="${PANDIR}/huntsman-environment-monitor"
export MEMORY_STATUS_FILE="${PANDIR}/images/memory_status.json"

## SSH ACCESS - The following hosts should be configured in ~/.ssh/config
export HUNTSMAN_REMOTE_HOST="huntsman_remote"
export HUNTSMAN_CAMERAS='[{"hostname": "huntsman_cam1", "num": 1, "use": "false"},{"hostname": "huntsman_cam2", "num": 2, "use": "false"},{"hostname": "huntsman_cam3", "num": 3, "use": "true"},{"hostname": "huntsman_cam4", "num": 4, "use": "true"},{"hostname": "huntsman_cam5", "num": 5, "use": "false"},{"hostname": "huntsman_cam6", "num": 6, "use": "false"},{"hostname": "huntsman_cam7", "num": 7, "use": "false"},{"hostname": "huntsman_cam8", "num": 8, "use": "false"},{"hostname": "huntsman_cam9", "num": 9, "use": "false"},{"hostname": "huntsman_cam10", "num": 10, "use": "false"}]'

## CONFIG
export PANOPTES_CONFIG_HOST="0.0.0.0"
export PANOPTES_CONFIG_PORT=6563
export PANOPTES_CONFIG_DIR="${PANDIR}/huntsman-config/conf_files"

## NATS Configuration
export NATS_SERVER="nats://localhost:4222"
export NATS_SCRIPT_DIR="${PANDIR}/huntsman-pocs/nats"
export NATS_CONSUMER_OUTPUT_DIR="${HOME}/Projects/huntsman/images"
export NATS_STATS_FILE="/tmp/stream_stats.json"
export NATS_NUM_STREAMS=10
export NATS_NUM_CONSUMERS=10
export NATS_NUM_WRITER_THREADS=4
export NATS_REMOTE_PYTHON_EXECUTABLE="/home/huntsman/conda/envs/huntsman-pocs/bin/python"
export NATS_REMOTE_SCRIPT_DIR="/home/huntsman/Projects/huntsman"
export NATS_CAMERA_SCRIPT_DIR="" # TODO: fix

## Docker
export DOCKER_BUILD_TAG="develop"
