export PANUSER="huntsman"
export PANDIR="/var/huntsman"
export PANLOG="${PANDIR}/logs"
export POCS="${PANDIR}/POCS"
export PAWS="${PANDIR}/PAWS"
export HUNTSMAN_POCS="${PANDIR}/huntsman-pocs"
export HUNTSMAN_DOME="${PANDIR}/huntsman-dome"
export HUNTSMAN_DRP="${PANDIR}/huntsman-drp"
export HUNTSMAN_LOG_DIR="${PANDIR}/logs"
export HUNTSMAN_ENV_MONITOR="${PANDIR}/huntsman-environment-monitor"
export MEMORY_STATUS_FILE="${PANDIR}/images/memory_status.json"

## SSH ACCESS
export HUNTSMAN_REMOTE_KEY="${HOME}/.ssh/huntsman_remote"
export HUNTSMAN_REMOTE_IP="xxx.xxx.xxx.xxx"
export HUNTSMAN_CAMERA_KEY="${HOME}/.ssh/huntsman_cameras"

## CONFIG
export PANOPTES_CONFIG_HOST="0.0.0.0"
export PANOPTES_CONFIG_PORT=6563
export PANOPTES_CONFIG_DIR="${PANDIR}/huntsman-config/conf_files"

## NATS Configuration
export NATS_SERVER="nats://localhost:4222"
export NATS_SCRIPT_DIR="${PANDIR}/huntsman-pocs/nats"
export NATS_CONSUMER_OUTPUT_DIR="${HOME}/Projects/huntsman/images"
