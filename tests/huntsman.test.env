## SYSTEM Variables
PANUSER="huntsman"
PANDIR="/huntsman"
PANLOG="/huntsman/logs"
HUNTSMAN_POCS="/huntsman"
HUNTSMAN_DOME="/var/huntsman/huntsman-dome"
HUNTSMAN_DRP="/var/huntsman/huntsman-drp"
HUNTSMAN_CONFIG="/var/huntsman/huntsman-config"

## SSH ACCESS - The following hosts should be configured in ~/.ssh/config
HUNTSMAN_REMOTE_HOST="huntsman_remote"
HUNTSAMN_CONSTROL_HOST="huntsman_control"
HUNTSMAN_CAMERAS='[{"hostname": "huntsman_cam1", "num": 1, "use": "false"},{"hostname": "huntsman_cam2", "num": 2, "use": "false"},{"hostname": "huntsman_cam3", "num": 3, "use": "true"},{"hostname": "huntsman_cam4", "num": 4, "use": "true"},{"hostname": "huntsman_cam5", "num": 5, "use": "false"},{"hostname": "huntsman_cam6", "num": 6, "use": "false"},{"hostname": "huntsman_cam7", "num": 7, "use": "false"},{"hostname": "huntsman_cam8", "num": 8, "use": "false"},{"hostname": "huntsman_cam9", "num": 9, "use": "false"},{"hostname": "huntsman_cam10", "num": 10, "use": "false"}]'

## CONFIG
PANOPTES_CONFIG_HOST="0.0.0.0"
PANOPTES_CONFIG_PORT=6563

## NATS Configuration
NATS_SERVER="nats://localhost:4222"
NATS_CONSUMER_OUTPUT_DIR="${HOME}/Projects/huntsman/images"
NATS_STATS_FILE="/tmp/stream_stats.json"
NATS_NUM_STREAMS=10
NATS_NUM_CONSUMERS=10
NATS_NUM_WRITER_THREADS=4
MEMORY_STATUS_FILE="/var/huntsman/images/memory_status.json"
MEMORY_THRESHOLD=31
